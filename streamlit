#!/usr/bin/env python3
"""Kick Mission Control — single-file Streamlit deployment.

Self-contained: every number the dashboard needs (model trajectories for 7
scenarios, metrics, McNemar, lead-time, robustness, calibration, SHAP
reasons) is embedded below as a compressed payload, so this ONE file runs
on Streamlit Cloud with no data/, models/ or src/ folders.

Tabs: Overview · Mission Control (scenario playback, alarm banner, gauges,
consensus, precomputed TreeSHAP reasons) · Evidence.

Generated by the repo tooling; the full repo version additionally serves
live SHAP on any row, the Plots tab and the FastAPI service.
"""
from __future__ import annotations

import base64
import json
import time
import zlib

import numpy as np
import pandas as pd
import streamlit as st

st.set_page_config(page_title="Kick Mission Control", page_icon="🛢️", layout="wide")

# ------------------------------------------------------------------ payload
PAYLOAD = json.loads(zlib.decompress(base64.b64decode("")))

METRICS = pd.DataFrame(PAYLOAD["metrics"])
MCNEMAR = pd.DataFrame(PAYLOAD["mcnemar"])
LEADTIME = pd.DataFrame(PAYLOAD["leadtime"])
SCEN = PAYLOAD["scenarios"]
FACTS = PAYLOAD["facts"]
CHANNELS_ORDER = ("FPress", "FIn", "FOut", "ATVolume", "MRFlow", "RoPen")
MODELS = ["random_forest", "xgboost", "xgboost_robust", "lstm",
          "decision_tree", "svm", "knn"]
MODEL_LABELS = {"random_forest": "Random Forest", "xgboost": "XGBoost",
                "xgboost_robust": "XGBoost+augmented", "lstm": "LSTM",
                "decision_tree": "Decision Tree", "svm": "SVM (RBF)", "knn": "KNN"}


def alarm_state(p: float) -> tuple[str, str]:
    if p >= 0.5:
        return "KICK", "🔴"
    return ("WARNING", "🟡") if p >= 0.3 else ("NORMAL", "🟢")


def strip_chart(sc: dict, model: str, pos: int, n: int = 300) -> None:
    import matplotlib

    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    s = max(0, pos - n + 1)
    times = sc["times"][s:pos + 1]
    proba = sc[model][s:pos + 1]
    actual = sc["actual"][s:pos + 1]
    fig, ax = plt.subplots(figsize=(9.5, 3.4))
    ax.plot(times, proba, lw=1.8, color="#0ea5e9")
    ax.axhline(0.5, ls="--", lw=1, color="#64748b")
    ax.fill_between(times, -0.04, 1.06, where=[bool(a) for a in actual],
                    color="#ef4444", alpha=0.12)
    ax.axvline(times[-1], lw=1.2, color="#0ea5e9", alpha=0.6)
    ax.set_ylim(-0.04, 1.06)
    ax.set_xlabel("simulation time, s")
    ax.set_ylabel("P(kick)")
    ax.set_title(f"{MODEL_LABELS[model]} — trailing window (red band = actual kick state)")
    st.pyplot(fig, clear_figure=True)


def why_panel(sc_key: str, pos: int) -> None:
    """Nearest precomputed XGBoost TreeSHAP attribution (real-well scenario)."""
    if sc_key != "real":
        st.info("Synthetic stream — switch to the real-well scenario for "
                "TreeSHAP attributions.")
        return
    rows = PAYLOAD["shap_rows"]  # {str(row_index): {base, sum, reasons}}
    keys = sorted(int(k) for k in rows)
    nearest = max(k for k in keys if k <= pos)
    out = rows[str(nearest)]
    st.markdown(f"**Top drivers near row {pos}** (sampled row {nearest}; base "
                f"{out['base']:+.2f} → log-odds sum {out['sum']:+.2f}) — "
                "precomputed XGBoost TreeSHAP")
    for r in out["reasons"]:
        sign = "+" if r["impact"] >= 0 else "−"
        st.markdown(
            f"- **{r['label']}** *{r['state']}* → pushes **{r['pushes']}** "
            f"`SHAP {sign}{abs(r['impact']):.2f}`")


# ================================================================== header
st.title("🛢️ Gas-Kick Detection — Mission Control")
st.caption(
    f"DataDRILL `Kick_Detection.csv` (Zenodo 12759014) · integrity-verified "
    f"md5 `{FACTS['md5'][:8]}…` · {FACTS['n_rows']:,} rows · kick onset "
    f"t={FACTS['onset_time']:.2f} s · recall-first evaluation "
    "(missed kick = catastrophic error) · single-file deployment")

tab_overview, tab_mission, tab_evidence, tab_plots = st.tabs(
    ["Overview", "Mission Control", "Evidence", "Plots"])

# ================================================================ Overview
with tab_overview:
    st.subheader("Model leaderboard — held-out test partition")
    winner = METRICS.sort_values(["Recall", "F1"], ascending=False).iloc[0]
    k1, k2, k3, k4 = st.columns(4)
    k1.metric("Recommended model", "Random Forest")
    k2.metric("Winner recall / F1", f"{winner['Recall']:.4f} / {winner['F1']:.4f}")
    k3.metric("Kick onset, s", f"{FACTS['onset_time']:.2f}")
    k4.metric("Severity head MAE", f"{PAYLOAD['severity']['mae']:.4f}")
    st.dataframe(METRICS, width="stretch", hide_index=True)
    with st.expander("Pairwise McNemar tests (15 pairs)"):
        st.dataframe(MCNEMAR, width="stretch", hide_index=True)
        st.caption("All classical models are statistically indistinguishable "
                   "(p=1.0); each differs significantly from the LSTM "
                   "(p=0.0015), which detects from temporal context alone.")

# ========================================================= Mission Control
with tab_mission:
    st.subheader("Live rig feed — scenario playback")
    c1, c2, c3, c4, c5 = st.columns([2, 2, 1, 1, 3])
    sc_key = c1.selectbox("Scenario", list(SCEN.keys()),
                          format_func=lambda k: SCEN[k]["meta"]["scenario"])
    model = c2.selectbox("Alarm model", MODELS,
                         format_func=lambda k: MODEL_LABELS[k], index=0)
    speed = c3.selectbox("Speed", [1, 2, 4, 16, 64], index=2)
    if "playing" not in st.session_state:
        st.session_state.playing = False
    if c4.button("▶ Play" if not st.session_state.playing else "⏸ Pause",
                 width="stretch"):
        st.session_state.playing = not st.session_state.playing
        st.rerun()

    sc = SCEN[sc_key]
    n = len(sc["times"])
    if "pos" not in st.session_state:
        st.session_state.pos = max(0, sc["meta"]["onset"] - 60)
    # clamp + playback advance BEFORE the slider widget exists (Streamlit rule)
    st.session_state.pos = min(st.session_state.pos, n - 1)
    if st.session_state.playing and st.session_state.pos < n - 1:
        st.session_state.pos = min(n - 1, st.session_state.pos + int(speed))
    pos = c5.slider("Feed position (row)", 0, n - 1, key="pos")
    pos = st.session_state.pos

    p = sc[model][pos]
    state, icon = alarm_state(p)
    actual = sc["actual"][pos]
    if state == "KICK":
        st.error(f"### {icon} {state} — P(kick) = {p:.2f}\n\n"
                 + ("**True kick in progress.**" if actual else
                    "No kick labelled on this synthetic/anomaly row — investigate."))
    elif state == "WARNING":
        st.warning(f"### {icon} {state} — P(kick) = {p:.2f} · early signature, confirming…")
    else:
        st.success(f"### {icon} {state} — P(kick) = {p:.2f} · all channels inside "
                   "commissioned envelope")

    left, right = st.columns([3, 2])
    with left:
        strip_chart(sc, model, pos)
        st.caption(f"t = **{sc['times'][pos]:.2f} s** · row {pos} of {n - 1} · "
                   f"scenario: *{sc['meta']['scenario']}*")
    with right:
        st.markdown("**Channel gauges**")
        g1, g2, g3 = st.columns(3)
        for col, ch in zip((g1, g2, g3), CHANNELS_ORDER[:3]):
            col.metric(ch, f"{sc['channels'][ch][pos]:.3f}")
        g4, g5, g6 = st.columns(3)
        for col, ch in zip((g4, g5, g6), CHANNELS_ORDER[3:]):
            col.metric(ch, f"{sc['channels'][ch][pos]:.3f}")
        g7, _, _ = st.columns(3)
        g7.metric("severity (influx)", f"{sc['severity'][pos]:.2f}")
        st.divider()
        why_panel(sc_key, pos)
        st.divider()
        st.markdown("**Model consensus at feed head**")
        cons = pd.DataFrame(
            [{"model": MODEL_LABELS[k], "P(kick)": sc[k][pos],
              "alarm": "🔴" if sc[k][pos] >= 0.5 else "—"} for k in MODELS])
        st.dataframe(cons, width="stretch", hide_index=True)

    if st.session_state.playing and st.session_state.pos < n - 1:
        time.sleep(max(0.0, 0.12 / int(speed)))
        st.rerun()
    elif st.session_state.pos >= n - 1:
        st.session_state.playing = False

# =============================================================== Evidence
with tab_evidence:
    st.subheader("Detection lead time — real recorded event")
    st.dataframe(LEADTIME, width="stretch", hide_index=True)
    st.caption("All commissioned detectors fire exactly at the recorded onset: "
               "the kick channels step simultaneously in this simulation. "
               "SVM's 58 nuisance rows above threshold are a calibration "
               "artefact → rejected for deployment.")

    st.subheader("Synthetic-kick generalisation (fire row vs injection row)")
    aug = PAYLOAD["augmentation"]
    st.dataframe(pd.DataFrame(
        [{"scenario": k, "injection row": v["injection_row"],
          "XGBoost fires": v["xgboost_fires"],
          "XGBoost+augmented fires": v["xgboost_robust_fires"],
          "LSTM fires": v["lstm_fires"]} for k, v in aug["scenarios"].items()]),
        width="stretch", hide_index=True)
    st.caption(f"Robust model (train + injected kicks) test metrics — accuracy "
               f"{aug['test_metrics']['accuracy']}, recall "
               f"{aug['test_metrics']['recall']}; zero false alarms on the "
               "drift/stuck anomaly scenarios.")

    st.subheader("Robustness & statistics")
    e1, e2 = st.columns(2)
    with e1:
        st.markdown("**Recall vs Gaussian sensor noise (× feature std)**")
        ns = PAYLOAD["robustness"]["noise_sweep"]
        chart = pd.DataFrame({MODEL_LABELS.get(k, k):
                              {r["sigma_std"]: r["recall"] for r in rows}
                              for k, rows in ns.items()})
        st.line_chart(chart, height=260)
    with e2:
        cal = PAYLOAD["robustness"]["calibration"]
        boots = PAYLOAD["robustness"]["bootstrap_recall"]
        c1_, c2_, c3_ = st.columns(3)
        c1_.metric("RF calibration ECE", f"{cal['random_forest']['ece']:.4f}")
        c2_.metric("LSTM calibration ECE", f"{cal['lstm']['ece']:.4f}")
        c3_.metric("LSTM recall 95% CI",
                   f"{boots['lstm']['lo']:.3f}–{boots['lstm']['hi']:.3f}")
        st.markdown("**Cross-time validation** (temporal retrain)")
        st.dataframe(pd.DataFrame(PAYLOAD["cross_time"]).T.rename_axis("model"),
                     width="stretch")
# ================================================================ Plots
with tab_plots:
    st.subheader("Evaluation figure library (embedded)")
    st.caption("All eight result figures from the full pipeline run — "
               "shipped inside this single file, no external assets.")
    cols = st.columns(2)
    for i, pl in enumerate(PAYLOAD["plots"]):
        png = base64.b64decode(pl["png_b64"])
        cols[i % 2].image(png, caption=pl["caption"], width="stretch")
